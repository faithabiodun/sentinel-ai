# Copy to .env and fill in. Never commit .env.

# --- CockroachDB Cloud -----------------------------------------------------
# From `ccloud cluster sql <cluster>` or the console connection string.
DATABASE_URL=postgresql://user:pass@host:26257/sentinel?sslmode=verify-full

# --- AWS -------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Claude on Bedrock. Requires model access enabled in the Bedrock console.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250929-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Raw telemetry and generated incident reports.
S3_BUCKET=sentinel-artifacts

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
